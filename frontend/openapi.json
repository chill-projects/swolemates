{
  "components": {
    "schemas": {
      "AuthConfigOut": {
        "properties": {
          "authkit_domain": {
            "title": "Authkit Domain",
            "type": "string"
          },
          "client_id": {
            "title": "Client Id",
            "type": "string"
          },
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "redirect_uri": {
            "title": "Redirect Uri",
            "type": "string"
          },
          "resource": {
            "title": "Resource",
            "type": "string"
          }
        },
        "required": [
          "configured",
          "authkit_domain",
          "client_id",
          "redirect_uri",
          "resource",
          "environment"
        ],
        "title": "AuthConfigOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "TmpxItemCreate": {
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "value": {
            "default": 0,
            "title": "Value",
            "type": "integer"
          }
        },
        "required": [
          "name"
        ],
        "title": "TmpxItemCreate",
        "type": "object"
      },
      "TmpxItemOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "value",
          "created_at"
        ],
        "title": "TmpxItemOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WhoamiOut": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "user_sub": {
            "title": "User Sub",
            "type": "string"
          }
        },
        "required": [
          "user_sub",
          "email",
          "display_name"
        ],
        "title": "WhoamiOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Swolemates",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/config": {
      "get": {
        "description": "Public: what the SPA needs to start an AuthKit login.\n\nUnauthenticated by design \u2014 the browser has to read this *before* it has a token.\nIt exposes only the client id and issuer, both of which are public values in an\nOAuth public-client flow. No secret is involved; AuthKit is PKCE-only here.",
        "operationId": "authConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthConfigOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Auth Config",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/tmpx": {
      "get": {
        "operationId": "listTmpxItems",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TmpxItemOut"
                  },
                  "title": "Response Listtmpxitems",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Tmpx Items",
        "tags": [
          "tmpx"
        ]
      },
      "post": {
        "operationId": "createTmpxItem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TmpxItemCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TmpxItemOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Tmpx Item",
        "tags": [
          "tmpx"
        ]
      }
    },
    "/api/tmpx/{item_id}": {
      "delete": {
        "operationId": "deleteTmpxItem",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Item Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Tmpx Item",
        "tags": [
          "tmpx"
        ]
      }
    },
    "/api/whoami": {
      "get": {
        "description": "The auth spike's REST half. If this returns your WorkOS sub, the browser flow works.\n\nemail/first_name/last_name come from the environment's JWT template \u2014 they're custom\nclaims, not defaults, so a missing email means the template got dropped in WorkOS.",
        "operationId": "whoami",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Whoami",
        "tags": [
          "auth"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness only \u2014 deliberately does not touch the database.\n\nRailway gates its blue-green cutover on this. If it depended on Postgres, a brief\ndatabase blip would block deploys of code that has nothing to do with the database.\nUse /health/ready for the dependency check.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "ops"
        ]
      }
    }
  }
}
