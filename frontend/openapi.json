{
  "components": {
    "schemas": {
      "AuthConfigOut": {
        "properties": {
          "authkit_domain": {
            "title": "Authkit Domain",
            "type": "string"
          },
          "client_id": {
            "title": "Client Id",
            "type": "string"
          },
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "redirect_uri": {
            "title": "Redirect Uri",
            "type": "string"
          },
          "resource": {
            "title": "Resource",
            "type": "string"
          }
        },
        "required": [
          "configured",
          "authkit_domain",
          "client_id",
          "redirect_uri",
          "resource",
          "environment"
        ],
        "title": "AuthConfigOut",
        "type": "object"
      },
      "GoalIn": {
        "properties": {
          "is_streak_target": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Streak Target"
          },
          "target_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Target Value"
          },
          "trackable_key": {
            "title": "Trackable Key",
            "type": "string"
          }
        },
        "required": [
          "trackable_key",
          "target_value"
        ],
        "title": "GoalIn",
        "type": "object"
      },
      "GoalOut": {
        "properties": {
          "is_streak_target": {
            "title": "Is Streak Target",
            "type": "boolean"
          },
          "period": {
            "title": "Period",
            "type": "string"
          },
          "target_value": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Target Value",
            "type": "string"
          },
          "trackable_key": {
            "title": "Trackable Key",
            "type": "string"
          }
        },
        "required": [
          "trackable_key",
          "target_value",
          "period",
          "is_streak_target"
        ],
        "title": "GoalOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LogNutritionRequest": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/NutritionEntryIn"
            },
            "minItems": 1,
            "title": "Entries",
            "type": "array"
          },
          "logged_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Logged At"
          },
          "meal_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meal Type"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "source": {
            "default": "manual",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "entries"
        ],
        "title": "LogNutritionRequest",
        "type": "object"
      },
      "LogOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "logged_at": {
            "format": "date-time",
            "title": "Logged At",
            "type": "string"
          },
          "meal_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meal Type"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "id",
          "name",
          "logged_at",
          "meal_type"
        ],
        "title": "LogOut",
        "type": "object"
      },
      "NutritionEntryIn": {
        "properties": {
          "trackable_key": {
            "title": "Trackable Key",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "trackable_key",
          "value"
        ],
        "title": "NutritionEntryIn",
        "type": "object"
      },
      "ProfileOut": {
        "properties": {
          "coach_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coach Notes"
          },
          "onboarding_completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Onboarding Completed At"
          },
          "weight_unit": {
            "$ref": "#/components/schemas/WeightUnit"
          }
        },
        "required": [
          "weight_unit",
          "coach_notes",
          "onboarding_completed_at"
        ],
        "title": "ProfileOut",
        "type": "object"
      },
      "ProfileUpdate": {
        "properties": {
          "coach_notes": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coach Notes"
          },
          "weight_unit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WeightUnit"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "ProfileUpdate",
        "type": "object"
      },
      "SetGoalsRequest": {
        "properties": {
          "goals": {
            "items": {
              "$ref": "#/components/schemas/GoalIn"
            },
            "minItems": 1,
            "title": "Goals",
            "type": "array"
          }
        },
        "required": [
          "goals"
        ],
        "title": "SetGoalsRequest",
        "type": "object"
      },
      "TmpxItemCreate": {
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "value": {
            "default": 0,
            "title": "Value",
            "type": "integer"
          }
        },
        "required": [
          "name"
        ],
        "title": "TmpxItemCreate",
        "type": "object"
      },
      "TmpxItemOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "value",
          "created_at"
        ],
        "title": "TmpxItemOut",
        "type": "object"
      },
      "TrackableTypeOut": {
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "goal_eligible": {
            "title": "Goal Eligible",
            "type": "boolean"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "unit",
          "category",
          "goal_eligible"
        ],
        "title": "TrackableTypeOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WeightUnit": {
        "enum": [
          "lbs",
          "kg"
        ],
        "title": "WeightUnit",
        "type": "string"
      },
      "WhoamiOut": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "user_sub": {
            "title": "User Sub",
            "type": "string"
          }
        },
        "required": [
          "user_sub",
          "email",
          "display_name"
        ],
        "title": "WhoamiOut",
