# `make db` writes a real backend/.env for you — you only need to edit it by hand when
# wiring up WorkOS (phase 3). See SETUP.md.

# local | test | production. `local` enables the DEV_USER_SUB auth bypass.
ENVIRONMENT=local

# Written by `make db`. Railway injects its own in production.
DATABASE_URL=postgresql+psycopg://postgres:@/swolemates?host=./.pgdata

# Must match the origin Claude actually connects to — it's the OAuth token audience.
PUBLIC_URL=http://localhost:8000

# WorkOS AuthKit. Leave blank locally; required in production.
AUTHKIT_DOMAIN=
WORKOS_CLIENT_ID=

# Who you are locally when no bearer token is present. Ignored unless ENVIRONMENT=local.
DEV_USER_SUB=dev_user_00000000
